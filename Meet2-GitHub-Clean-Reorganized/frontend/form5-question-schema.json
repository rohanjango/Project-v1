{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meet2.local/schema/form5-question-set.json",
  "title": "Meet 2 Dynamic Form 5 Question Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "student_stage", "question_count", "questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "role_id": {"type": "string", "minLength": 1},
    "student_stage": {"type": "string", "minLength": 1},
    "question_count": {"const": 5},
    "questions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill_id", "skill_label", "signal", "response_type", "question", "helper_text", "options"],
        "properties": {
          "id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
          "skill_id": {"type": "string", "minLength": 1},
          "skill_label": {"type": "string", "minLength": 1},
          "signal": {"type": "string", "enum": ["experience", "confidence", "scenario", "interest", "behavior"]},
          "response_type": {"type": "string", "enum": ["single_select", "scenario_single_select", "scale_1_5"]},
          "question": {"type": "string", "minLength": 10},
          "helper_text": {"type": "string", "minLength": 1},
          "options": {
            "type": "array", "minItems": 2, "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["value", "label", "score"],
              "properties": {
                "value": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "score": {"type": "integer", "minimum": 1, "maximum": 5}
              }
            }
          }
        }
      }
    }
  }
}
